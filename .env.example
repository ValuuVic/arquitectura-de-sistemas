# Sustituye ambas claves por valores aleatorios independientes antes de ejecutar.
DJANGO_SECRET_KEY=replace-with-a-random-django-secret
JWT_SIGNING_KEY=replace-with-a-random-independent-key-at-least-32-bytes
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1
